# The sdist is what a downstream packager or a rebuild machine unpacks, so it
# has to carry the inputs the build depends on and nothing it cannot run.
#
# build-constraints.txt pins setuptools, which uv resolves in a build
# environment uv.lock does not describe. Without it in the archive, a wheel
# rebuilt from this sdist installs whatever backend the index serves that day,
# and the bytes move under a fixed SOURCE_DATE_EPOCH: reproducible from a git
# checkout, not from what it publishes. `make build` passes the same file, so
# the pin ships with the tree it pins.
include build-constraints.txt

# distutils' default sdist picks up tests/test_*.py and nothing else from
# tests/, so the archive carried sixteen modules whose conftest.py and
# coverage_fixture.py were absent: a suite that fails on collection, and
# dev-only files in a published artifact. `make test` needs the sibling rebrew
# checkout too, so it is not a test the sdist could run either way.
prune tests

# The man page installs through [tool.setuptools.data-files]; a rebuild from
# the sdist needs the source the wheel copies out of it.
include man/recoverage.1

# A downstream packager takes the changelog from the archive it unpacks, and
# the wheel metadata already points a reader at one. It is the record of what
# each tag contains, so the sdist that carries the code has to carry it.
include CHANGELOG.md

# setuptools writes src/recoverage.egg-info/ into the tree it builds from and
# the default sdist then ships it: generated build metadata, a second PKG-INFO
# and the unpacked requirements, in an archive that already carries the same
# facts at its root. It is gitignored here, so it is a leftover of whichever
# build ran last, not part of what this commit contains, and the wheel build
# regenerates it, so pruning it costs a rebuild nothing. SOURCES.txt is the one
# member that stays: setuptools writes it after this file is read, so no
# exclusion rule here can reach it.
prune src/recoverage.egg-info
