{
  "name": "recoverage",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "description": "Frontend tooling for the recoverage dashboard (Preact + Tailwind build, JS/TS + HTML/CSS lint)",
  "scripts": {
    "lint": "bun run lint:js && bun run lint:html",
    "lint:js": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:html": "uv run --locked --extra dev python tools/lint_html.py",
    "build:web": "bun run web/build.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit --project web/tsconfig.json"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@preact/preset-vite": "2.10.6",
    "@rikalabs/oxlint-standards": "0.8.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "oxlint": "1.89.0",
    "preact": "11.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vnu-jar": "26.10.12"
  }
}
