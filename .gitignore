# Virtual environments
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Testing
.pytest_cache/
.pytest-tmp/

# Build artifacts
dist/
build/
*.egg-info/
*.egg

# Linting / type checking
.ruff_cache/
.mypy_cache/
.pyre_configuration

# Frontend tooling (oxlint, vnu-jar)
node_modules/

# Scratch space (experiments, probes, throwaway files)
.scratch/

# Coverage documents the smoke harness and the serve harness write into a
# project's coverage directory (runtime artifact, not source).  The SQLite
# database this pattern used to ignore is no longer produced: rebrew writes
# db/coverage-<target>.toml and recoverage only reads them.
db/
coverage.db
coverage.db-shm
coverage.db-wal
coverage.db.lock
.bun-cache/
.bun-tmp/
web/dist/
.uv-cache/

# The sbom job's two artifacts, by the names it uploads them under. The job
# writes them on the runner, where nothing reads the tree afterwards, but
# `make python-sbom > recoverage-python-sbom.txt` is the documented way to
# reproduce one on a workstation, and a root file an ignore list does not name
# is one `git add .` picks up.
recoverage-python-sbom.txt
recoverage-browser-sbom.txt
