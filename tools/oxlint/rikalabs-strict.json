{
  "options": {
    "typeAware": false
  },
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "node",
    "oxc",
    "promise",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "rules": {
    "oxc/no-barrel-file": [
      "error",
      {
        "threshold": 0
      }
    ],
    "oxc/no-async-await": "off",
    "oxc/no-accumulating-spread": "error",
    "eslint/eqeqeq": [
      "error",
      "always"
    ],
    "eslint/no-unused-expressions": "error",
    "eslint/no-sequences": "error",
    "eslint/no-unreachable": "error",
    "eslint/no-constant-condition": "error",
    "eslint/func-names": "off",
    "eslint/no-undefined": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "eslint/no-extend-native": "error",
    "eslint/no-global-assign": "error",
    "eslint/no-implicit-globals": "error",
    "eslint/use-isnan": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-fallthrough": "error",
    "eslint/default-case": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-void": "off",
    "eslint/no-script-url": "error",
    "eslint/no-prototype-builtins": "error",
    "unicorn/no-object-as-default-parameter": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/group-exports": "off",
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/exports-last": "off",
    "import/prefer-default-export": "off",
    "import/consistent-type-specifier-style": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "promise/no-callback-in-promise": "error",
    "promise/no-return-in-finally": "error",
    "promise/no-multiple-resolved": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/filename-case": "off",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-null": "off",
    "unicorn/error-message": "error",
    "unicorn/catch-error-name": [
      "error",
      {
        "name": "error"
      }
    ],
    "unicorn/throw-new-error": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-module": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/no-thenable": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-useless-spread": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-import-type-side-effects": "error",
    "typescript/unbound-method": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/require-await": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unnecessary-qualifier": "error",
    "import/first": "error",
    "import/no-absolute-path": "error",
    "import/no-mutable-exports": "error",
    "import/no-commonjs": "error",
    "import/no-dynamic-require": "error",
    "import/max-dependencies": [
      "error",
      {
        "max": 35
      }
    ],
    "@rikalabs/no-import-then-reexport": "error",
    "promise/no-nesting": "error",
    "promise/no-new-statics": "error",
    "promise/param-names": "error",
    "promise/valid-params": "error",
    "promise/catch-or-return": "error",
    "promise/always-return": "off",
    "typescript/no-floating-promises": "error",
    "typescript/promise-function-async": "off",
    "typescript/return-await": "off",
    "promise/prefer-await-to-then": "off",
    "@rikalabs/no-vague-verbs": "error",
    "@rikalabs/no-duplicate-context": "error",
    "@rikalabs/no-is-record-helpers": "error",
    "@rikalabs/no-as-never": "error",
    "@rikalabs/no-placeholder-implementation": "error",
    "@rikalabs/no-disable-without-rationale": "error",
    "@rikalabs/no-todo-without-issue": "error",
    "@rikalabs/no-anemic-errors": "error",
    "@rikalabs/no-low-signal-public-names": "error",
    "@rikalabs/no-generic-module-names": "error",
    "@rikalabs/no-identical-branches": "error",
    "@rikalabs/no-copy-paste-exports": "error",
    "@rikalabs/no-trivial-runtime-guard-helpers": "error",
    "@rikalabs/no-trivial-property-helpers": "error",
    "@rikalabs/no-bare-wrapper-functions": "error",
    "@rikalabs/no-pass-through-intermediate-vars": "error",
    "@rikalabs/no-redundant-const-assertion": "error",
    "@rikalabs/no-tutorial-comments": "error",
    "@rikalabs/no-commented-out-code": "error",
    "@rikalabs/no-debug-residue-filenames": "error",
    "@rikalabs/no-low-signal-variable-names": "error",
    "@rikalabs/no-standalone-classes": "error",
    "@rikalabs/no-hardcoded-secrets": "error",
    "@rikalabs/no-sql-string-concat": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-deprecated": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": {
          "descriptionFormat": "^: .+"
        }
      }
    ],
    "typescript/restrict-plus-operands": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      {
        "ignoreArrowShorthand": true
      }
    ],
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-includes": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "as"
      }
    ],
    "typescript/no-empty-object-type": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-namespace": "error",
    "typescript/array-type": [
      "error",
      {
        "default": "generic"
      }
    ],
    "import/no-anonymous-default-export": "error",
    "promise/no-return-wrap": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-useless-return": "error",
    "eslint/no-await-in-loop": "off",
    "eslint/no-continue": "off",
    "eslint/no-negated-condition": "off",
    "eslint/no-param-reassign": "error",
    "eslint/no-empty": "error",
    "eslint/no-useless-catch": "error",
    "eslint/no-empty-function": "error",
    "eslint/require-yield": "off",
    "eslint/no-ternary": "off",
    "eslint/no-console": "error",
    "eslint/no-warning-comments": "error",
    "eslint/no-shadow": [
      "error",
      {
        "hoist": "functions"
      }
    ],
    "eslint/no-return-assign": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-constructor-return": "error",
    "eslint/no-alert": "error",
    "eslint/no-new-func": "error",
    "eslint/curly": [
      "error",
      "all"
    ],
    "eslint/no-else-return": "error",
    "eslint/no-implicit-coercion": [
      "error",
      {
        "boolean": true,
        "number": true,
        "string": true
      }
    ],
    "eslint/no-multi-assign": "error",
    "eslint/no-template-curly-in-string": "error",
    "eslint/no-labels": "error",
    "eslint/no-lone-blocks": "error",
    "eslint/id-length": "off",
    "eslint/max-statements": "off",
    "eslint/new-cap": "off",
    "eslint/prefer-object-has-own": "error",
    "eslint/prefer-object-spread": "off",
    "eslint/prefer-template": "error",
    "eslint/max-params": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 60,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/max-classes-per-file": [
      "error",
      1
    ],
    "eslint/max-lines": [
      "error",
      {
        "max": 1500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/complexity": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-nested-ternary": "error",
    "eslint/no-debugger": "error",
    "eslint/no-eval": "error",
    "eslint/no-implied-eval": "error",
    "eslint/prefer-promise-reject-errors": "error",
    "eslint/max-nested-callbacks": [
      "error",
      4
    ],
    "@rikalabs/no-silent-catch-fallback": "error",
    "@rikalabs/no-runtime-compat-fallbacks": "error",
    "@rikalabs/no-catch-return-error-object": "error",
    "@rikalabs/no-unlisted-external-imports": "error",
    "@rikalabs/no-double-type-assertion": "error",
    "@rikalabs/no-ai-debt-comments": "error",
    "@rikalabs/no-json-parse-default-fallback": "error",
    "@rikalabs/no-json-stringify-default-fallback": "error",
    "typescript/consistent-type-definitions": [
      "error",
      "type"
    ],
    "unicorn/no-static-only-class": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-map-spread": "off",
    "node/no-process-env": "error",
    "node/no-path-concat": "error",
    "node/handle-callback-err": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/no-import-node-test": "error",
    "vitest/prefer-called-once": "error",
    "vitest/consistent-test-filename": "error",
    "vitest/prefer-called-times": "error",
    "vitest/prefer-to-be-falsy": "error",
    "vitest/prefer-to-be-truthy": "error",
    "vitest/prefer-to-be-object": "error",
    "jsdoc/check-tag-names": "error",
    "jsdoc/check-property-names": "error",
    "jsdoc/check-access": "error",
    "jsdoc/empty-tags": "error",
    "jsdoc/implements-on-classes": "error",
    "jsdoc/no-defaults": "off",
    "jsdoc/require-property": "error",
    "jsdoc/require-property-description": "error",
    "jsdoc/require-property-name": "error",
    "jsdoc/require-yields": "error",
    "jsdoc/require-param": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-returns-type": "off",
    "@rikalabs/no-placeholder-tests": "error",
    "@rikalabs/no-mock-only-tests": "error"
  },
  "overrides": [
    {
      "files": [
        "**/scripts/**/*.{ts,tsx,mts,cts,mjs,cjs}",
        "**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "**/tools/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "**/*.{test,spec}.{ts,tsx,mts,cts}",
        "**/__tests__/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
