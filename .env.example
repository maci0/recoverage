# Every recoverage runtime setting, with the default the server uses when the
# variable is absent. Nothing here is read automatically: export these, or set
# them in a systemd unit's EnvironmentFile / a container spec's environment.
# A value left commented is the default; an UNCOMMENTED value is a change from
# it, so the diff of this file against a deployment is the deployment's diff
# from a stock one.
#
# An UNRECOGNIZED RECOVERAGE_* NAME IS A STARTUP ERROR, not a no-op: a
# misspelling is caught at boot rather than leaving a default in place.

# Where the dashboard listens. RECOVERAGE_BIND is an interface address or a
# hostname (no whitespace, no host:port); a non-loopback bind needs
# RECOVERAGE_ALLOW_REMOTE or serve exits 1.
# RECOVERAGE_BIND=127.0.0.1
# RECOVERAGE_PORT=8001

# Required with a non-loopback bind: an acknowledgment that the API, including
# raw binary bytes and disassembly, is reachable from the network.
# RECOVERAGE_ALLOW_REMOTE=false

# The bearer token every request must carry. The only secret this file names:
# set it in the environment (never in argv, where `ps` reads it) and it never
# reaches a log line or a health report. SET-BUT-EMPTY means auth off, on
# purpose; leave the line commented rather than empty. A value with leading or
# trailing whitespace, an interior space, or a control character is a startup
# error: request headers arrive trimmed, so no client could ever present it.
# RECOVERAGE_TOKEN=replace-with-a-long-random-value

# Cross-origin reads, allowlist-only. An origin no browser could send is a
# startup error, and an empty allowlist with CORS on is a warning rather than
# a silent wildcard. A value that names no origin at all (empty, or only commas
# and whitespace) is a startup error, so a unit file, a container env or a CI
# job that spells "not configured" as an empty value cannot start a server that
# refuses every cross-origin read.
# RECOVERAGE_CORS=false
# RECOVERAGE_CORS_ORIGIN=http://localhost:5173

# Log threshold: a logging level name or its number (one of 0, 10, 20, 30, 40,
# 50). DEBUG adds the per-request lines. A number outside that set is a startup
# error: it would leave the process logging nothing at all.
# RECOVERAGE_LOG_LEVEL=INFO

# Transport bounds. The admission cap is one thread and one descriptor per
# connection, so it is sized by the deployment's memory; the deadline is per
# socket operation, so it bounds how slow a client may be before a write is
# cut mid-body, not how long a connection may live. The cap is an integer
# 1-65536 and the deadline an integer 16-86400; a value outside either is a
# startup error.
# RECOVERAGE_MAX_CONNECTIONS=128
# RECOVERAGE_CLIENT_TIMEOUT=120

# The coverage directory, for a service not started from the project root.
# Otherwise it resolves from rebrew-project.toml's [project] db_dir, else ./db.
# RECOVERAGE_DB=/srv/project/db

# Read by the fuzz campaigns (make fuzz), not by the server.
# RECOVERAGE_FUZZ_SEED=20260927
# RECOVERAGE_FUZZ_ITERATIONS=400
